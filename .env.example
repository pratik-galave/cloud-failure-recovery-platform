# ==============================================================================
# FaultLens Cloud Resilience Platform - Environment Configuration Example
# Copy this file to .env and configure for your deployment environment
# ==============================================================================

# 1. Target Microservice Configuration
TARGET_SERVICE_PORT=5001
TARGET_SERVICE_NODE_ENV=production

# 2. FaultLens Auditor Backend Configuration
AUDITOR_PORT=5000
AUDITOR_NODE_ENV=production
# In Docker Compose, services resolve each other via internal container DNS:
TARGET_SERVICE_URL=http://target-service:5001
# Persistent database location (mounted to Docker named volume 'faultlens-data')
DATABASE_PATH=/app/data/faultlens.db

# 3. FaultLens Dashboard (React Operations Console) Configuration
DASHBOARD_PORT=5173
# For cloud VM deployments (e.g. AWS EC2), set this to your public VM IP/Domain:
# VITE_API_BASE=http://<YOUR_EC2_PUBLIC_IP>:5000/api
VITE_API_BASE=http://localhost:5000/api

# 4. Security & Safety Settings
# Privileged Docker operations are strictly restricted to this allowlisted container:
ALLOWED_DOCKER_CONTAINER=faultlens-target-service
